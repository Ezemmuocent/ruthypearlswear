# Environment Variables Configuration for RuthyPearls Wear

# API Configuration
NEXT_PUBLIC_API_URL=https://www.rpwears.com

# Stripe Payment Processing (get from https://dashboard.stripe.com)
NEXT_PUBLIC_STRIPE_KEY=pk_test_your_public_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Authentication Secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your_generated_secret_here

# Database Configuration (if using MongoDB, PostgreSQL, Firebase, etc.)
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/ruthypearlswear

# Flutterwave Payment (Alternative to Stripe for Nigeria)
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key

# Email Service (SendGrid, Mailgun, etc.)
SENDGRID_API_KEY=your_sendgrid_api_key

# Analytics (Google Analytics, Mixpanel, etc.)
NEXT_PUBLIC_GA_ID=your_google_analytics_id

# Environment
NODE_ENV=production
